{
  "name": "payload-content-cli",
  "version": "0.1.0-beta.0",
  "description": "A CLI for managing Payload CMS content, built for AI agents.",
  "keywords": [
    "agent",
    "ai",
    "claude",
    "cli",
    "cms",
    "content-sync",
    "filesystem",
    "headless-cms",
    "lexical",
    "payload",
    "payload-cms",
    "richtext",
    "sync"
  ],
  "homepage": "https://github.com/jhb-software/payload-content-cli#readme",
  "bugs": {
    "url": "https://github.com/jhb-software/payload-content-cli/issues"
  },
  "license": "MIT",
  "author": "Jens Becker <info@jhb.software>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhb-software/payload-content-cli.git"
  },
  "bin": {
    "payload-content": "./bin/payload-content.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "USAGE.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/cli.js",
    "./plugin": "./dist/plugin/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && tsc && cp src/agent-skill.md dist/",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt . '!example/**'",
    "format:check": "oxfmt --check . '!example/**'",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:dev": "pnpm --filter payload-content-cli-example dev",
    "example:seed": "pnpm --filter payload-content-cli-example seed"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.6"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{md,json,jsonc,yml,yaml,js,cjs,mjs}": [
      "oxfmt"
    ],
    "{plans,.github}/**/*.{md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.2"
}
